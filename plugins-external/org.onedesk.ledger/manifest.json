        "label": "kind.receipt",
        "icon": "package-plus",
        "tree": "resources",
        "page": "voucher",
        "newName": "kind.receipt.new",
        "defaults": {
          "date": "",
          "no": "",
          "handler": "",
          "party": "",
          "summary": "",
          "lines": []
