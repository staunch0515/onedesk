      {
        "id": "post",
        "label": "action.post",
        "icon": "book-check",
        "kinds": [
          "receipt",
          "issue",
          "count"
        ],
        "output": "text"
      },
      {
        "id": "export",
        "label": "action.export",
        "icon": "file-down",
        "kinds": [
          "summary"
        ],
        "output": "text",
        "saveFirst": true
      },
      {
        "id": "roles",
        "label": "action.roles",
        "output": "none"
      },
      {
        "id": "outline",
        "label": "action.outline",
        "output": "none"
      },
      {
        "id": "entries",
        "label": "action.entries",
        "output": "none"
      }
