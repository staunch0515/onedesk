{
  "id": "org.onedesk.ledger",
  "version": "0.1.0",
  "apiVersion": "2",
  "name": "plugin.name",
  "description": "plugin.description",
  "icon": "book-text",
  "main": "main.js",
  "author": "OneDesk",
  "license": "MIT",
  "requires": {
    "resources": true,
    "files": true
  },
  "uses": [
    "onedesk.book/1"
  ],
  "implements": {
    "onedesk.book/1": {
      "actions": [
        "roles",
        "outline",
        "entries"
      ],
      "kind": "item",
      "kinds": [
        "setup",
        "catalog",
        "sheet",
        "receipt",
        "issue",
        "count",
        "vouchers",
        "summary"
      ]
    }
  },
  "exports": {
    "actions": [
      "roles",
      "outline",
      "entries"
    ]
  },
  "contributes": {
    "kinds": [
      {
        "id": "setup",
        "label": "kind.setup",
        "icon": "clipboard-signature",
        "tree": "resources",
        "page": "setup",
        "newName": "kind.setup.new",
        "defaults": {
          "unitName": "",
          "started": "",
          "method": "moving",
          "qtyDecimals": 2,
          "amountDecimals": 2,
          "keepers": "",
          "handover": "",
          "closed": []
        },
        "draggable": true,
        "accepts": []
      },
      {
        "id": "catalog",
        "label": "kind.catalog",
        "icon": "list",
        "tree": "resources",
        "page": "catalog",
        "newName": "kind.catalog.new",
        "defaults": {},
        "draggable": true,
        "accepts": []
