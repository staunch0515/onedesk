            "id": "post",
            "role": "run",
            "action": "post",
            "label": "action.post",
            "icon": "book-check"
          },
          {
            "id": "reverse",
            "role": "event",
            "label": "action.reverse",
            "icon": "undo-2"
          },
          {
            "id": "revise",
            "role": "event",
            "label": "action.revise",
            "icon": "file-pen"
          },
          {
            "id": "save",
            "role": "save",
            "label": "action.save",
            "icon": "save",
            "primary": true,
            "shortcut": [
              "Mod",
              "S"
            ]
          }
        ],
        "resultTabs": [
          {
            "id": "out",
            "type": "output",
            "label": "tab.post",
            "icon": "file-text"
          }
        ]
      },
      {
        "id": "vouchers",
        "actions": []
      },
      {
        "id": "summary",
        "recompute": true,
        "actions": [
          {
            "id": "close",
            "role": "event",
            "label": "action.close",
            "icon": "lock"
          },
          {
            "id": "reopen",
            "role": "event",
            "label": "action.reopen",
            "icon": "lock-open"
          },
          {
            "id": "export",
            "role": "run",
            "action": "export",
            "label": "action.export",
            "icon": "file-down"
          },
          {
            "id": "save",
            "role": "save",
            "label": "action.save",
            "icon": "save",
            "primary": true,
            "shortcut": [
              "Mod",
              "S"
            ]
          }
        ],
        "resultTabs": [
          {
            "id": "out",
            "type": "output",
            "label": "tab.export",
            "icon": "file-text"
          }
        ]
      }
