        "draggable": true,
        "accepts": []
      },
      {
        "id": "issue",
        "label": "kind.issue",
        "icon": "package-minus",
        "tree": "resources",
        "page": "voucher",
        "newName": "kind.issue.new",
        "defaults": {
          "date": "",
          "no": "",
          "handler": "",
          "party": "",
          "summary": "",
          "lines": []
        },
        "draggable": true,
        "accepts": []
      },
      {
        "id": "count",
        "label": "kind.count",
        "icon": "clipboard-check",
        "tree": "resources",
        "page": "voucher",
        "newName": "kind.count.new",
        "defaults": {
          "date": "",
          "no": "",
          "handler": "",
          "summary": "",
          "lines": []
        },
        "draggable": true,
        "accepts": []
      },
      {
        "id": "vouchers",
        "label": "kind.vouchers",
        "icon": "folder-archive",
