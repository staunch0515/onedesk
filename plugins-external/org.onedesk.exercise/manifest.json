{
  "id": "org.onedesk.exercise",
  "version": "0.1.0",
  "apiVersion": "2",
  "name": "plugin.name",
  "description": "plugin.description",
  "icon": "graduation-cap",
  "main": "main.js",
  "author": "OneDesk",
  "license": "MIT",
  "requires": {
    "files": false,
    "resources": true
  },
  "uses": [
    "onedesk.book/1"
  ],
  "implements": {
    "onedesk.book/1": {
      "actions": [
        "roles",
        "outline",
        "entries",
        "conventions"
      ],
      "kind": "practice",
      "kinds": [
        "question",
        "test",
        "lessons",
        "answers"
      ]
    },
    "onedesk.letter/1": {
      "actions": [
        "tasks",
        "todo",
        "reply"
      ],
      "kind": "test"
    }
  },
  "exports": {
    "actions": [
      "roles",
      "outline",
      "entries",
      "conventions",
      "tasks",
      "todo",
      "reply"
    ]
  },
  "contributes": {
    "trees": [
      {
        "id": "records",
        "label": "tree.records",
        "icon": "graduation-cap",
        "source": "stored"
      }
    ],
    "kinds": [
      {
        "id": "question",
        "label": "kind.question",
        "icon": "circle-help",
        "tree": "resources",
        "page": "question",
        "newName": "kind.question.new",
        "defaults": {
          "type": "fill",
          "stem": "",
          "options": "",
          "answers": "",
          "rule": "number",
          "points": 1,
          "hint": "",
          "explanation": "",
          "difficulty": null
        },
        "draggable": true,
        "accepts": [],
        "embed": true,
        "fields": {
          "stem": {
            "type": "longtext",
            "refs": true
          },
          "explanation": {
            "type": "longtext",
            "refs": true,
            "withheld": true
          },
          "hint": {
            "type": "longtext",
            "refs": true
          },
          "answers": {
            "type": "longtext",
            "withheld": true
          }
        }
      },
      {
        "id": "practice",
        "label": "kind.practice",
        "icon": "pencil-line",
        "tree": "resources",
        "page": "practice",
        "newName": "kind.practice.new",
        "defaults": {},
        "draggable": true,
        "accepts": [
          "question"
        ],
        "embed": true
      },
      {
        "id": "test",
        "label": "kind.test",
        "icon": "clipboard-check",
        "tree": "resources",
        "page": "test",
        "newName": "kind.test.new",
        "defaults": {
          "timing": "release",
          "tries": 0,
          "keep": "best",
          "limit": 0,
          "editable": true,
          "partial": false,
          "items": []
        },
        "draggable": true,
        "accepts": [
          "question"
        ],
        "embed": true
      },
      {
        "id": "lessons",
        "label": "kind.lessons",
        "icon": "list-checks",
        "tree": "resources",
        "page": "lessons",
        "newName": "kind.lessons.new",
        "defaults": {},
        "draggable": true,
        "accepts": [],
        "embed": true
      },
      {
        "id": "subject",
        "label": "kind.subject",
        "icon": "folder",
        "tree": "records",
        "page": "grades",
        "newName": "kind.subject.new",
        "defaults": {},
        "draggable": true,
        "accepts": [
          "attempt"
        ]
      },
      {
        "id": "attempt",
        "label": "kind.attempt",
        "icon": "file-check",
        "tree": "records",
        "page": "attempt",
        "newName": "kind.attempt.new",
        "defaults": {},
        "draggable": true,
        "accepts": []
      },
      {
        "id": "grades",
        "label": "kind.grades",
        "icon": "chart-column",
        "tree": "records",
        "page": "grades",
        "newName": "kind.grades.new",
        "defaults": {},
        "draggable": true,
        "accepts": []
      },
      {
        "id": "mistakes",
        "label": "kind.mistakes",
        "icon": "notebook-pen",
        "tree": "records",
        "page": "mistakes",
        "newName": "kind.mistakes.new",
        "defaults": {},
        "draggable": true,
        "accepts": []
      },
      {
        "id": "answers",
        "label": "kind.answers",
        "icon": "key-square",
        "tree": "resources",
        "page": "answers",
        "newName": "kind.answers.new",
        "defaults": {
          "release": ""
        },
        "draggable": true,
        "accepts": [],
        "embed": true
      }
    ],
    "pages": [
      {
        "id": "question",
        "recompute": true,
        "actions": [
          {
            "id": "save",
            "role": "save",
            "label": "action.save",
            "icon": "save",
            "primary": true,
            "shortcut": [
              "Mod",
              "S"
            ]
          }
        ]
      },
      {
        "id": "practice",
        "actions": [
          {
            "id": "check",
            "role": "event",
            "label": "action.check",
            "icon": "check"
          },
          {
            "id": "again",
            "role": "event",
            "label": "action.again",
            "icon": "rotate-ccw"
          },
          {
            "id": "generate",
            "role": "event",
            "label": "action.generate",
            "icon": "list-plus"
          },
          {
            "id": "save",
            "role": "save",
            "label": "action.save",
            "icon": "save",
            "primary": true,
            "shortcut": [
              "Mod",
              "S"
            ]
          }
        ]
      },
      {
        "id": "test",
        "recompute": true,
        "actions": [
          {
            "id": "start",
            "role": "event",
            "label": "action.start",
            "icon": "play"
          },
          {
            "id": "generate",
            "role": "event",
            "label": "action.generate",
            "icon": "list-plus"
          },
          {
            "id": "refer",
            "role": "event",
            "label": "action.refer",
            "icon": "link"
          },
          {
            "id": "save",
            "role": "save",
            "label": "action.save",
            "icon": "save",
            "primary": true,
            "shortcut": [
              "Mod",
              "S"
            ]
          }
        ]
      },
      {
        "id": "attempt",
        "recompute": true,
        "actions": [
          {
            "id": "submit",
            "role": "event",
            "label": "action.submit",
            "icon": "send"
          },
          {
            "id": "save",
            "role": "save",
            "label": "action.save",
            "icon": "save",
            "primary": true,
            "shortcut": [
              "Mod",
              "S"
            ]
          }
        ]
      },
      {
        "id": "grades",
        "actions": []
      },
      {
        "id": "mistakes",
        "actions": [
          {
            "id": "retry",
            "role": "event",
            "label": "action.retry",
            "icon": "rotate-ccw"
          }
        ]
      },
      {
        "id": "lessons",
        "actions": [
          {
            "id": "toggle",
            "role": "event",
            "label": "action.pages",
            "icon": "book-open"
          }
        ]
      },
      {
        "id": "answers",
        "actions": [
          {
            "id": "release",
            "role": "run",
            "action": "release",
            "label": "action.release",
            "icon": "megaphone"
          },
          {
            "id": "save",
            "role": "save",
            "label": "action.save",
            "icon": "save",
            "primary": true,
            "shortcut": [
              "Mod",
              "S"
            ]
          }
        ],
        "resultTabs": [
          {
            "id": "out",
            "type": "output",
            "label": "tab.release",
            "icon": "file-text"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "roles",
        "label": "action.roles",
        "output": "none"
      },
      {
        "id": "outline",
        "label": "action.outline",
        "output": "none"
      },
      {
        "id": "entries",
        "label": "action.entries",
        "output": "none"
      },
      {
        "id": "release",
        "label": "action.release",
        "icon": "megaphone",
        "kinds": [
          "answers"
        ],
        "output": "text",
        "saveFirst": true
      },
      {
        "id": "conventions",
        "label": "action.conventions",
        "output": "none"
      },
      {
        "id": "tasks",
        "label": "action.letter.tasks",
        "output": "none"
      },
      {
        "id": "todo",
        "label": "action.letter.todo",
        "output": "none"
      },
      {
        "id": "reply",
        "label": "action.letter.reply",
        "output": "none"
      }
    ],
    "menus": {
      "new": [
        "question",
        "practice",
        "test",
        "lessons",
        "grades",
        "mistakes",
        "answers"
      ]
    },
    "locales": {
      "en-US": "locales/en-US.json",
      "zh-CN": "locales/zh-CN.json",
      "ja-JP": "locales/ja-JP.json"
    },
    "events": [
      "resource.changed",
      "letter.reply"
    ]
  },
  "depends": [
    {
      "id": "org.onedesk.book",
      "version": ">=0.1.0, <1.0.0"
    }
  ]
}
