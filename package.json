{
  "name": "onedesk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile=false && pnpm exec playwright install chromium",
    "start": "pnpm tauri dev",
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "prototype": "vite --port 1431 --strictPort --open /workbench.html",
    "prototype:build": "node scripts/build-prototype.mjs",
    "tauri": "tauri",
    "devhost": "cargo build -p onedesk-worker -p onedesk-host && target/debug/onedesk-devhost",
    "typecheck": "tsc -p .",
    "lint": "node scripts/check-arch.mjs && node scripts/check-ui.mjs",
    "test": "vitest run",
    "test:rust": "cargo test --workspace",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "e2e": "playwright test",
    "e2e:app": "playwright test e2e/smoke-app.spec.ts",
    "smoke:app": "sh scripts/smoke-app.sh",
    "check": "pnpm check:types && pnpm typecheck && pnpm lint && pnpm test && pnpm test:rust && pnpm clippy && ONEDESK_E2E_REQUIRE_DEVHOST=1 pnpm e2e",
    "gen:types": "sh scripts/gen-types.sh",
    "check:types": "sh scripts/gen-types.sh --check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tauri-apps/api": "^2.12.4",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.72.0",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
