{
  "id": "org.onedesk.sample",
  "version": "0.2.0",
  "apiVersion": "2",
  "name": "plugin.name",
  "description": "plugin.description",
  "icon": "flask-conical",
  "main": "main.js",
  "author": "OneDesk",
  "license": "MIT",
  "homepage": "https://onedesk.example.com/plugins/sample",
  "requires": {
    "files": false,
    "network": {
      "hosts": [
        "example.com"
      ]
    }
  },
  "contributes": {
    "kinds": [
      {
        "id": "query",
        "label": "kind.query",
        "icon": "file-code",
        "tree": "resources",
        "page": "editor",
        "newName": "kind.query.new",
        "defaults": {
          "text": ""
        },
        "draggable": true,
        "accepts": []
      }
    ],
    "actions": [
      {
        "id": "run",
        "label": "action.run",
        "icon": "play",
        "kinds": [
          "query"
        ],
        "output": "table",
        "shortcut": [
          "Mod",
          "Enter"
        ],
        "saveFirst": false,
        "confirm": null
      },
      {
        "id": "explain",
        "label": "action.explain",
        "icon": "info",
        "kinds": [
          "query"
        ],
        "output": "text",
        "saveFirst": false,
        "confirm": null
      }
    ],
    "pages": [
      {
        "id": "editor",
        "recompute": true,
        "usesEnv": true,
        "actions": [
          {
            "id": "run",
            "role": "run",
            "action": "run",
            "label": "action.run",
            "icon": "play",
            "primary": true,
            "shortcut": [
              "Mod",
              "Enter"
            ]
          },
          {
            "id": "save",
            "role": "save",
            "label": "action.save",
            "icon": "save",
            "shortcut": [
              "Mod",
              "S"
            ]
          },
          {
            "id": "save-run",
            "role": "save-run",
            "action": "run",
            "label": "action.saveRun",
            "icon": "save-all"
          },
          {
            "id": "explain",
            "role": "run",
            "action": "explain",
            "label": "action.explain",
            "icon": "info"
          },
          {
            "id": "tidy",
            "role": "event",
            "label": "action.tidy",
            "icon": "align-left"
          }
        ],
        "resultTabs": [
          {
            "id": "result",
            "type": "output",
            "label": "tab.result",
            "icon": "table"
          },
          {
            "id": "final",
            "type": "view",
            "label": "tab.final",
            "icon": "code"
          },
          {
            "id": "history",
            "type": "history",
            "label": "tab.history",
            "icon": "history"
          }
        ]
      }
    ],
    "settings": [
      {
        "name": "rowLimit",
        "label": "setting.rowLimit",
        "type": "number",
        "default": "200",
        "hint": "setting.rowLimit.hint"
      },
      {
        "name": "style",
        "label": "setting.style",
        "type": "enum",
        "default": "upper",
        "options": [
          {
            "value": "upper",
            "label": "setting.style.upper"
          },
          {
            "value": "lower",
            "label": "setting.style.lower"
          }
        ]
      }
    ],
    "menus": {
      "new": [
        "query"
      ]
    },
    "locales": {
      "en-US": "locales/en-US.json",
      "zh-CN": "locales/zh-CN.json"
    }
  },
  "upgradesFrom": ">=0.1.0, <0.2.0"
}
