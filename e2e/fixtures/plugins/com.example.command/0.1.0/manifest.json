{
  "id": "com.example.command",
  "version": "0.1.0",
  "apiVersion": "2",
  "name": "plugin.name",
  "description": "plugin.description",
  "icon": "terminal",
  "main": "main.js",
  "author": "OneDesk",
  "license": "MIT",
  "requires": {
    "files": false,
    "programs": [
      { "name": "echo", "source": "system" },
      { "name": "sleep", "source": "system" },
      { "name": "sh", "source": "system" },
      { "name": "hello", "source": "plugin", "path": "bin/hello.sh" }
    ]
  },
  "contributes": {
    "kinds": [
      {
        "id": "command",
        "label": "kind.command",
        "icon": "terminal",
        "tree": "resources",
        "page": "editor",
        "newName": "kind.command.new",
        "defaults": { "program": "echo", "args": "", "env": "" },
        "fields": {
          "env": { "type": "longtext", "secrets": true }
        },
        "draggable": true,
        "accepts": []
      }
    ],
    "actions": [
      {
        "id": "run",
        "label": "action.run",
        "icon": "play",
        "kinds": ["command"],
        "output": "text",
        "shortcut": ["Mod", "Enter"],
        "saveFirst": false,
        "confirm": null
      }
    ],
    "pages": [
      {
        "id": "editor",
        "recompute": true,
        "usesEnv": false,
        "actions": [
          { "id": "run", "role": "run", "action": "run", "label": "action.run", "icon": "play", "primary": true, "shortcut": ["Mod", "Enter"] },
          { "id": "save", "role": "save", "label": "action.save", "icon": "save", "shortcut": ["Mod", "S"] },
          { "id": "save-run", "role": "save-run", "action": "run", "label": "action.saveRun", "icon": "save-all" }
        ],
        "resultTabs": [
          { "id": "result", "type": "output", "label": "tab.result", "icon": "terminal" },
          { "id": "history", "type": "history", "label": "tab.history", "icon": "history" }
        ]
      }
    ],
    "events": ["resource.changed", "run.ended"],
    "menus": { "new": ["command"] },
    "locales": { "en-US": "locales/en-US.json", "zh-CN": "locales/zh-CN.json" }
  },
  "upgradesFrom": ">=0.1.0"
}
