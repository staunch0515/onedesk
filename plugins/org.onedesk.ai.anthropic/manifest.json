{
  "id": "org.onedesk.ai.anthropic",
  "version": "0.1.0",
  "apiVersion": "2",
  "name": "plugin.name",
  "description": "plugin.description",
  "icon": "sparkles",
  "main": "main.js",
  "author": "OneDesk",
  "license": "MIT",
  "homepage": "https://onedesk.example.com/plugins/ai-anthropic",
  "requires": {
    "files": false,
    "network": {
      "fromResources": true
    },
    "secrets": {
      "names": [],
      "plaintext": false
    }
  },
  "implements": {
    "onedesk.ai.chat/1": {
      "actions": ["chat", "models", "test"],
      "kind": "connection"
    }
  },
  "exports": {
    "kinds": [
      {
        "id": "connection",
        "actions": true,
        "read": true
      }
    ],
    "actions": ["chat", "models", "test"]
  },
  "contributes": {
    "kinds": [
      {
        "id": "connection",
        "label": "kind.connection",
        "icon": "sparkles",
        "tree": "resources",
        "page": "editor",
        "newName": "kind.connection.new",
        "defaults": {
          "baseUrl": "https://api.anthropic.com",
          "model": "claude-haiku-5-5",
          "effort": "medium",
          "maxTokens": "16000",
          "fallback": "true"
        },
        "fields": {
          "baseUrl": {
            "type": "text",
            "grants": "network"
          },
          "secret": {
            "type": "secret"
          }
        },
        "draggable": false,
        "accepts": []
      }
    ],
    "actions": [
      {
        "id": "test",
        "label": "action.test",
        "icon": "plug-zap",
        "kinds": ["connection"],
        "output": "text",
        "saveFirst": true,
        "confirm": null
      },
      {
        "id": "chat",
        "label": "action.chat",
        "icon": "message-square",
        "output": "text",
        "saveFirst": false,
        "confirm": null
      },
      {
        "id": "models",
        "label": "action.models",
        "icon": "list",
        "output": "text",
        "saveFirst": false,
        "confirm": null
      }
    ],
    "pages": [
      {
        "id": "editor",
        "recompute": true,
        "actions": [
          {
            "id": "test",
            "role": "run",
            "action": "test",
            "label": "action.test",
            "icon": "plug-zap",
            "primary": true,
            "shortcut": ["Mod", "Enter"]
          },
          {
            "id": "save",
            "role": "save",
            "label": "action.save",
            "icon": "save",
            "shortcut": ["Mod", "S"]
          },
          {
            "id": "save-test",
            "role": "save-run",
            "action": "test",
            "label": "action.saveTest",
            "icon": "save-all"
          }
        ],
        "resultTabs": [
          {
            "id": "response",
            "type": "output",
            "label": "tab.result",
            "icon": "file-text"
          },
          {
            "id": "history",
            "type": "history",
            "label": "tab.history",
            "icon": "history"
          }
        ]
      }
    ],
    "menus": {
      "new": ["connection"]
    },
    "locales": {
      "en-US": "locales/en-US.json",
      "zh-CN": "locales/zh-CN.json",
      "ja-JP": "locales/ja-JP.json"
    }
  }
}
