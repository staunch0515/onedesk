{
  "id": "org.onedesk.sql",
  "version": "0.1.0",
  "apiVersion": "2",
  "name": "plugin.name",
  "description": "plugin.description",
  "icon": "file-code",
  "main": "main.js",
  "author": "OneDesk",
  "license": "MIT",
  "homepage": "https://onedesk.example.com/plugins/sql",
  "requires": {
    "files": false
  },
  "depends": [
    {
      "id": "org.onedesk.datasource",
      "version": ">=0.1.0, <1.0.0"
    }
  ],
  "exports": {
    "actions": [
      "create"
    ]
  },
  "contributes": {
    "kinds": [
      {
        "id": "query",
        "label": "kind.query",
        "icon": "file-code",
        "tree": "resources",
        "page": "editor",
        "newName": "kind.query.new",
        "defaults": {
          "sql": "",
          "source": ""
        },
        "draggable": true,
        "accepts": []
      }
    ],
    "actions": [
      {
        "id": "run",
        "label": "action.run",
        "icon": "play",
        "kinds": [
          "query"
        ],
        "output": "table",
        "shortcut": [
          "Mod",
          "Enter"
        ],
        "saveFirst": false,
        "confirm": null
      },
      {
        "id": "create",
        "label": "action.create",
        "icon": "file-plus",
        "output": "link",
        "saveFirst": false,
        "confirm": null
      },
      {
        "id": "newHere",
        "label": "action.newHere",
        "icon": "file-plus",
        "kinds": [
          "org.onedesk.datasource:source"
        ],
        "output": "link",
        "saveFirst": false,
        "confirm": null
      }
    ],
    "pages": [
      {
        "id": "editor",
        "recompute": true,
        "usesEnv": true,
        "actions": [
          {
            "id": "run",
            "role": "run",
            "action": "run",
            "label": "action.run",
            "icon": "play",
            "primary": true,
            "shortcut": [
              "Mod",
              "Enter"
            ]
          },
          {
            "id": "save",
            "role": "save",
            "label": "action.save",
            "icon": "save",
            "shortcut": [
              "Mod",
              "S"
            ]
          },
          {
            "id": "save-run",
            "role": "save-run",
            "action": "run",
            "label": "action.saveRun",
            "icon": "save-all"
          },
          {
            "id": "copy",
            "role": "event",
            "label": "action.copy",
            "icon": "copy"
          }
        ],
        "resultTabs": [
          {
            "id": "result",
            "type": "output",
            "label": "tab.result",
            "icon": "table"
          },
          {
            "id": "sent",
            "type": "view",
            "label": "tab.sent",
            "icon": "file-code"
          },
          {
            "id": "history",
            "type": "history",
            "label": "tab.history",
            "icon": "history"
          }
        ]
      }
    ],
    "menus": {
      "new": [
        "query"
      ]
    },
    "locales": {
      "en-US": "locales/en-US.json",
      "zh-CN": "locales/zh-CN.json",
      "ja-JP": "locales/ja-JP.json"
    }
  }
}