      {
        "id": "roles",
        "label": "action.roles",
        "output": "none"
      },
      {
        "id": "outline",
        "label": "action.outline",
        "output": "none"
      },
      {
        "id": "entries",
        "label": "action.entries",
        "output": "none"
      },
      {
        "id": "number",
        "label": "action.number",
        "output": "none"
      },
      {
        "id": "cite",
        "label": "action.cite",
        "output": "none"
