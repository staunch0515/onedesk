        "draggable": true,
        "accepts": [],
        "embed": true
      },
      {
        "id": "conventions",
        "label": "kind.conventions",
        "icon": "list-checks",
        "tree": "resources",
        "page": "conventions",
        "newName": "kind.conventions.new",
        "defaults": {
          "text": "",
          "terms": [],
          "symbols": []
