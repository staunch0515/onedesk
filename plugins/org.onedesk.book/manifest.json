          "readOnly": true,
          "description": "ai.tool.contents"
        }
      },
      {
        "id": "aiPage",
        "label": "action.ai.page",
        "icon": "bot",
        "output": "text",
        "saveFirst": false,
        "ai": {
          "readOnly": true,
          "description": "ai.tool.page"
        }
      },
      {
        "id": "aiRefs",
        "label": "action.ai.refs",
        "icon": "bot",
        "output": "text",
        "saveFirst": false,
        "ai": {
          "readOnly": true,
          "description": "ai.tool.refs"
        }
      },
