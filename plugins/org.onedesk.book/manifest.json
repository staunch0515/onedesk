        "icon": "image",
        "tree": "resources",
        "page": "cover",
        "newName": "kind.cover.new",
        "defaults": {
          "subtitle": "",
          "authors": "",
          "image": null,
          "blurb": ""
        },
        "draggable": true,
        "accepts": [],
        "embed": true,
        "fields": {
          "image": {
            "type": "attachment",
            "accept": [
              "image"
            ],
            "label": "field.image"
          }
        }
      },
      {
        "id": "toc",
        "label": "kind.toc",
        "icon": "list-tree",
        "tree": "resources",
        "page": "toc",
