      },
      {
        "id": "figures",
        "label": "kind.figures",
        "icon": "images",
        "tree": "resources",
        "page": "figures",
        "newName": "kind.figures.new",
        "defaults": {},
        "draggable": true,
        "accepts": [],
        "embed": true
      },
