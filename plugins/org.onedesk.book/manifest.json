    ],
    "menus": {
      "new": [
        "book",
        "page",
        "preface",
        "afterword",
        "appendix",
        "cover",
        "toc",
        "references",
        "reference",
        "index",
        "figures",
        "colophon"
      ]
    },
    "locales": {
      "en-US": "locales/en-US.json",
      "zh-CN": "locales/zh-CN.json",
      "ja-JP": "locales/ja-JP.json"
    },
    "aiTools": [
      {
        "name": "book_contents",
        "description": "ai.tool.contents",
        "action": "aiContents",
        "freeQuery": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "The book's id (or any resource in it)"
            }
          },
          "required": [
            "book"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "book_page",
        "description": "ai.tool.page",
        "action": "aiPage",
        "freeQuery": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The page's id"
            },
            "book": {
              "type": "string",
              "description": "The book it is in (from book_contents)"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "book_refs",
        "description": "ai.tool.refs",
        "action": "aiRefs",
        "freeQuery": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "The book's id (or any resource in it)"
            }
          },
          "required": [
            "book"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "book_check",
        "description": "ai.tool.check",
        "action": "aiCheck",
        "freeQuery": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "book": {
              "type": "string",
              "description": "The book's id (or any resource in it)"
            }
          },
          "required": [
            "book"
          ],
          "additionalProperties": false
        }
