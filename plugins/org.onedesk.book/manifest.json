        "draggable": true,
        "accepts": [],
        "embed": true,
        "fields": {
          "text": {
            "type": "longtext",
            "refs": true
          }
        }
      },
      {
        "id": "page",
        "label": "kind.page",
        "icon": "file-text",
        "tree": "resources",
        "page": "text",
        "newName": "kind.page.new",
        "defaults": {
          "text": ""
        },
        "draggable": true,
        "accepts": [],
        "embed": true,
        "fields": {
          "text": {
            "type": "longtext",
            "refs": true
          }
        }
      },
      {
        "id": "afterword",
        "label": "kind.afterword",
        "icon": "file-text",
        "tree": "resources",
        "page": "text",
        "newName": "kind.afterword.new",
        "defaults": {
          "text": ""
