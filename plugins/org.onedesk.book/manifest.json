{
  "id": "org.onedesk.book",
  "version": "0.1.0",
  "apiVersion": "2",
  "name": "plugin.name",
  "description": "plugin.description",
  "icon": "book-open",
  "main": "main.js",
  "author": "OneDesk",
  "license": "MIT",
  "requires": {
    "files": true,
    "resources": true,
    "contents": true
  },
  "uses": [
    "onedesk.book/1"
  ],
  "implements": {
    "onedesk.book/1": {
      "actions": [
        "roles",
        "outline",
        "entries",
        "number",
        "cite"
      ],
      "kind": "page",
      "kinds": [
        "book",
        "cover",
        "toc",
        "preface",
        "afterword",
        "appendix",
        "references",
        "reference",
        "index",
        "figures",
        "colophon",
        "conventions"
      ]
    }
  },
  "exports": {
    "actions": [
      "roles",
      "outline",
      "entries",
      "number",
      "cite",
      "print"
    ]
  },
  "contributes": {
    "kinds": [
      {
