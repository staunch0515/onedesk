            "id": "publish",
            "role": "run",
            "action": "publish",
            "label": "action.publish",
            "icon": "book-up"
          },
          {
            "id": "reprint",
            "role": "run",
            "action": "reprint",
            "label": "action.reprint",
            "icon": "printer"
          },
          {
            "id": "save",
            "role": "save",
            "label": "action.save",
            "icon": "save",
            "primary": true,
            "shortcut": [
              "Mod",
              "S"
            ]
          }
        ],
        "resultTabs": [
          {
            "id": "out",
            "type": "output",
            "label": "tab.publish",
            "icon": "file-text"
