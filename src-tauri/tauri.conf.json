{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneDesk",
  "version": "1.0.0",
  "identifier": "org.onedesk.app",
  "build": {
    "beforeDevCommand": "sh scripts/prepare-bundle.sh debug && pnpm dev",
    "devUrl": "http://localhost:1420/workbench.html",
    "beforeBuildCommand": "sh scripts/prepare-bundle.sh release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OneDesk",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "11.3"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/onedesk-worker",
      "binaries/onedesk-mcp"
    ],
    "resources": {
      "../target/bundle-inputs/plugins": "plugins"
    }
  }
}